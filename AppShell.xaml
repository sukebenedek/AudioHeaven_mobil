<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AudioHeaven.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AudioHeaven"
    xmlns:localPages="clr-namespace:AudioHeaven.Pages"
    Title="AudioHeaven"
    Shell.BackgroundColor="Black"
    Shell.FlyoutBehavior="Disabled"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage" />


    <TabBar Route="main">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate localPages:HomePage}"
            Icon="home.png" />
        <ShellContent
            Title="Search"
            ContentTemplate="{DataTemplate localPages:SearchPage}"
            Icon="search.png" />
        <ShellContent
            Title="My Music"
            ContentTemplate="{DataTemplate localPages:MyMusicPage}"
            Icon="note.png" />
        <ShellContent
            Title="Library"
            ContentTemplate="{DataTemplate localPages:LibraryPage}"
            Icon="library.png" />
    </TabBar>

</Shell>
