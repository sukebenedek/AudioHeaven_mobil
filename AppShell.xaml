<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AudioHeaven.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AudioHeaven"
    xmlns:localPages="clr-namespace:AudioHeaven.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="AudioHeaven"
   
    Shell.BackgroundColor="Black"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    >

    <ShellContent
    Title="Login"
    ContentTemplate="{DataTemplate local:MainPage}"
    Route="MainPage" />


    <TabBar Route="main">
        <ShellContent
        Title="Home"
        Icon="home.png"
        ContentTemplate="{DataTemplate localPages:HomePage}"
        />
        <ShellContent
        Title="Search"
        Icon="search.png"
        ContentTemplate="{DataTemplate localPages:SearchPage}" />
        <ShellContent
        Title="My Songs"
        Icon="note.png"
        ContentTemplate="{DataTemplate localPages:MySongsPage}" />
        <ShellContent
        Title="Library"
        Icon="library.png"
        ContentTemplate="{DataTemplate localPages:LibraryPage}" />
    </TabBar>

</Shell>
