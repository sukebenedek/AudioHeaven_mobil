<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AudioHeaven.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AudioHeaven"
    xmlns:localPages="clr-namespace:AudioHeaven.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="AudioHeaven">

    <ShellContent
    Title="Login"
    ContentTemplate="{DataTemplate local:MainPage}"
    Route="LoginPage" />


    <TabBar Route="main">
        <ShellContent
        Title="Home"
        Icon="home"
        ContentTemplate="{DataTemplate localPages:HomePage}"
        Route="HomePage" />
        <!--<ShellContent
        Title="Search"
        Icon="search"
        ContentTemplate="{DataTemplate localPages:SearchPage}" />-->
    </TabBar>

</Shell>
