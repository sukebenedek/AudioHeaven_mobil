<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:AudioHeaven.Components"
             xmlns:bottomsheet="http://pluginmauibottomsheet.com"
             x:Class="AudioHeaven.Pages.HomePage">
    
    <Shell.TitleView>
       <Grid ColumnDefinitions="*, Auto" Padding="10,0">
           <Label Text="AudioHeaven" 
                      FontSize="20" 
                      FontAttributes="Bold" 
                      VerticalOptions="Center" 
           />

           <comp:ProfileButton Grid.Column="1" 
                                   Clicked="OnProfileTapped" 
                                   VerticalOptions="Center"
           />
       </Grid> 
    </Shell.TitleView>
    
    <Grid>
        <ScrollView>
            <Label 
            Text="Welcome to .NET MAUI!"
            HorizontalOptions="Center" />
        </ScrollView>

        <bottomsheet:BottomSheet x:Name="LogoutSheet"
                         HasHandle="True"
                         CornerRadius="10"
                         IsModal="True"
                         States="Peek"
                         CurrentState="Peek"
                                 PeekHeight="120">
            <bottomsheet:BottomSheet.Content>
                <bottomsheet:BottomSheetContent>
                    <comp:LogoutSheetContent LogoutRequested="OnLogoutRequestedOnPage"/>
                </bottomsheet:BottomSheetContent>
            </bottomsheet:BottomSheet.Content>
        </bottomsheet:BottomSheet>
    </Grid>
</ContentPage>
