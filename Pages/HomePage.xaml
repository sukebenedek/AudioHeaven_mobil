<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioHeaven.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:bottomsheet="http://pluginmauibottomsheet.com"
    xmlns:comp="clr-namespace:AudioHeaven.Components"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <Shell.TitleView>
        <Grid Padding="10,0" ColumnDefinitions="*, Auto">
            <Label
                FontAttributes="Bold"
                FontSize="33"
                Text="Home"
                VerticalOptions="Center" />
            <comp:ProfileButton
                Grid.Column="1"
                Clicked="OnProfileTapped"
                VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="0,0,0,80">
                <toolkit:MediaElement
                    x:Name="GlobalPlayer"
                    IsVisible="False"
                    Loaded="OnPlayerLoaded"
                    MetadataArtist="{Binding MusicService.CurrentSong.Title}"
                    MetadataArtworkUrl="{Binding MusicService.CurrentSong.FullCoverUrl}"
                    MetadataTitle="{Binding MusicService.CurrentSong.User.Name}"
                    ShouldAutoPlay="False" />
                <Label
                    FontSize="150"
                    HorizontalOptions="Center"
                    Text="Welcome to .NET MAUI!"
                    VerticalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <comp:FloatingPlayer Margin="5,0,5,10" VerticalOptions="End" />
        <comp:LogoutSheetContent x:Name="LogoutMenu" />

    </Grid>

</ContentPage>
