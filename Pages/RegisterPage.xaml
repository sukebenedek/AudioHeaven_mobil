<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioHeaven.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:AudioHeaven.Components"
    Title="RegisterPage">
    <Grid Padding="30" RowDefinitions="Auto, *">
        <VerticalStackLayout
            Grid.Row="1"
            HeightRequest="500"
            Spacing="20"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="0">
                <Entry
                    Keyboard="Email"
                    Placeholder="Email..."
                    Text="{Binding InputEmail}" />

                <!--<BoxView HeightRequest="1" Color="{StaticResource DarkGray}" Margin="0,5,0,0" />-->
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="0">
                <Entry
                    Keyboard="Text"
                    Placeholder="Username..."
                    Text="{Binding InputUsername}" />

                <!--<BoxView HeightRequest="1" Color="{StaticResource DarkGray}" Margin="0,5,0,0" />-->
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="0">
                <Entry
                    IsPassword="True"
                    Placeholder="Password..."
                    Text="{Binding InputPassword1}" />

                <!--<BoxView HeightRequest="1" Color="{StaticResource DarkGray}" Margin="0,5,0,0" />-->
            </VerticalStackLayout>
            <VerticalStackLayout Margin="0,0,0,20" Spacing="0">
                <Entry
                    IsPassword="True"
                    Placeholder="Password..."
                    Text="{Binding InputPassword2}" />

                <!--<BoxView HeightRequest="1" Color="{StaticResource DarkGray}" Margin="0,5,0,0" />-->
            </VerticalStackLayout>


            <Button
                Margin="0,50,0,0"
                BackgroundColor="{StaticResource DarkBlue}"
                Command="{Binding RegisterBtnClickedCommand}"
                CornerRadius="4"
                FontAttributes="Bold"
                FontSize="30"
                HeightRequest="65"
                HorizontalOptions="Center"
                Text="Register"
                TextColor="{StaticResource White}"
                WidthRequest="180" />

            <!--<VerticalStackLayout HorizontalOptions="Center" Spacing="-8">
                <Button Text="Login"
                   TextColor="{StaticResource LightGray}"
                   HorizontalOptions="Center"
                   BackgroundColor="Transparent"
                   FontSize="18"
                   Command="{Binding LoginBtnClickedCommand}"
                    >
                </Button>

                <BoxView HeightRequest="1"
                 Color="{StaticResource LightGray}"
                 HorizontalOptions="Fill"
                 WidthRequest="50"
            />
            </VerticalStackLayout>-->
        </VerticalStackLayout>

        <comp:LoadingOverlay
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="-30"
            HorizontalOptions="Fill"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Fill" />
    </Grid>
</ContentPage>