<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioHeaven.Pages.QueuePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:AudioHeaven.Components"
    Title="Your queue"
    Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="*">
        <VerticalStackLayout Padding="20,20,20,80">
            <CollectionView CanReorderItems="True" ItemsSource="{Binding MusicService.Queue}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <comp:SongItemRow Format="username" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <comp:FloatingPlayer Margin="5,0,5,10" VerticalOptions="End" />
    </Grid>
</ContentPage>