<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:AudioHeaven.Components"
             x:Class="AudioHeaven.Pages.AllSongsPage"
             Title="All of your songs"
             Shell.TabBarIsVisible="False"
             >
    <ScrollView>
        <Grid>

            <VerticalStackLayout Padding="20" Grid.Row="0"  Spacing="10">
            <CollectionView ItemsSource="{Binding Songs}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <comp:SongItemRow />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <comp:LoadingOverlay Grid.Row="0" 
                 VerticalOptions="Fill" 
                 HorizontalOptions="Fill" 
                 Margin="-30" IsVisible="{Binding IsBusy}"/>
        </Grid>
    </ScrollView>
</ContentPage>