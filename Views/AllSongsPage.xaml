<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioHeaven.Pages.AllSongsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:AudioHeaven.Components"
    Title="Songs"
    Shell.TabBarIsVisible="False">
    <ScrollView>
        <Grid RowDefinitions="*">

            <VerticalStackLayout
                Grid.Row="0"
                Padding="20"
                Spacing="10">
                <CollectionView ItemsSource="{Binding Songs}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <comp:SongItemRow Format="plays" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <comp:LoadingOverlay
                Grid.Row="0"
                Margin="-30"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Fill" />
            <comp:FloatingPlayer
                Grid.Row="0"
                Margin="5,0,5,10"
                VerticalOptions="End" />
        </Grid>
    </ScrollView>
</ContentPage>