<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioHeaven.Views.SearchedSongsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:AudioHeaven.Components"
    Title="Songs containing:">
    <Grid RowDefinitions="*">
        <ScrollView Grid.Row="0" Padding="0,0,0,80">
            <VerticalStackLayout Padding="20" Spacing="10">
                <CollectionView ItemsSource="{Binding Songs}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <comp:SongItemRow Format="username" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <comp:FloatingPlayer Margin="5,0,5,10" VerticalOptions="End" />
    </Grid>
</ContentPage>