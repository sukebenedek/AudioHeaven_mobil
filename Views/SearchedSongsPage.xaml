<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioHeaven.Views.SearchedSongsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:AudioHeaven.Components"
    Title="Songs containing:">
    <ScrollView>
        <Grid>

            <CollectionView ItemsSource="{Binding Songs}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <comp:SongItemRow Format="username" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <comp:FloatingPlayer Margin="5,0,5,10" VerticalOptions="End" />
        </Grid>
    </ScrollView>
</ContentPage>