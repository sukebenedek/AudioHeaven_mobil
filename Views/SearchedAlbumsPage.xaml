<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioHeaven.Views.SearchedAlbumsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:AudioHeaven.Components"
    Title="Albums"
    Shell.TabBarIsVisible="False">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Margin="0,0,0,100">
                <CollectionView ItemsSource="{Binding Albums}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <comp:AlbumItemRow />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <comp:FloatingPlayer Margin="5,0,5,10" VerticalOptions="End" />
    </Grid>
</ContentPage>