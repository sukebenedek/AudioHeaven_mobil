<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioHeaven.Views.SongPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:AudioHeaven.Components"
    Title="{Binding CurrentSong.Title}"
    BackgroundColor="Black">

    <Grid RowDefinitions="Auto, *, Auto">

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Grid.Row="1"
                Padding="0,15"
                Spacing="25">

                <Frame
                    Padding="0"
                    BorderColor="Transparent"
                    CornerRadius="20"
                    HeightRequest="320"
                    HorizontalOptions="Center"
                    IsClippedToBounds="True"
                    WidthRequest="320">
                    <Image Aspect="AspectFill" Source="{Binding CurrentSong.FullCoverUrl}" />
                </Frame>

                <Grid
                    Margin="10,0"
                    ColumnDefinitions="*, Auto"
                    VerticalOptions="Center">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Padding="20,0,0,0"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="28"
                            LineBreakMode="TailTruncation"
                            Text="{Binding CurrentSong.Title}"
                            TextColor="White" />
                        <Label
                            FontSize="18"
                            Text="{Binding CurrentSong.User.Name}"
                            TextColor="Gray">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="GoToUserPage" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="1"
                        Margin="0,0,20,0"
                        BackgroundColor="{StaticResource LightBlue}"
                        HeightRequest="60"
                        HorizontalOptions="End"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="60">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30" />
                        </Border.StrokeShape>
                        <ImageButton
                            Grid.Column="1"
                            Padding="15"
                            BackgroundColor="Transparent"
                            Clicked="OnPlayClicked"
                            HeightRequest="60"
                            HorizontalOptions="Center"
                            Source="paused"
                            VerticalOptions="Center"
                            WidthRequest="60" />
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <comp:LoadingOverlay
            Grid.Row="0"
            Grid.RowSpan="3"
            Margin="-30"
            HorizontalOptions="Fill"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Fill" />
        <comp:FloatingPlayer
            Grid.RowSpan="3"
            Margin="5,0,5,10"
            InputTransparent="False"
            VerticalOptions="End"
            ZIndex="10" />
    </Grid>
</ContentPage>