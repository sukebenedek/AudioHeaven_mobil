<ContentView
    x:Class="AudioHeaven.Components.SongItemRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:AudioHeaven.Components"
    xmlns:models="clr-namespace:AudioHeaven.Models"
    x:DataType="models:Song">

    <Grid
        Padding="10,7"
        ColumnDefinitions="Auto, *, Auto"
        ColumnSpacing="15">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnPlaySongClicked" />
        </Grid.GestureRecognizers>

        <Border
            Grid.Column="0"
            HeightRequest="60"
            StrokeShape="RoundRectangle 10"
            WidthRequest="60">
            <Image Aspect="AspectFill" Source="{Binding FullCoverUrl}" />
        </Border>

        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="{Binding Title}"
                TextColor="White">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoToSongPageClicked" />
                </Label.GestureRecognizers>
            </Label>

            <Label
                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type comp:SongItemRow}}, Path=ShowPlays}"
                Text="{Binding Plays, StringFormat='{0} plays'}"
                TextColor="Gray" />

            <Label
                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type comp:SongItemRow}}, Path=ShowUsername}"
                Text="{Binding User.Name}"
                TextColor="Gray">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoToUserPageClicked" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

        <ImageButton
            Grid.Column="2"
            BackgroundColor="Transparent"
            HeightRequest="26"
            Source="meatballs.png"
            WidthRequest="26" />
    </Grid>
</ContentView>