<ContentView
    x:Class="AudioHeaven.Components.SongItemRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:AudioHeaven.Components"
    xmlns:models="clr-namespace:AudioHeaven.Models"
    x:DataType="models:Song">

    <Grid>

        <Grid
            Padding="10,7"
            ColumnDefinitions="Auto, *, Auto"
            ColumnSpacing="15"
            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type comp:SongItemRow}}, Path=IsCard, Converter={StaticResource InverseBoolConverter}}">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPlaySongClicked" />
            </Grid.GestureRecognizers>

            <Border
                Grid.Column="0"
                HeightRequest="60"
                StrokeShape="RoundRectangle 10"
                WidthRequest="60">
                <Image Aspect="AspectFill" Source="{Binding FullCoverUrl}" />
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="{Binding Title}"
                    TextColor="White" />

                <Label
                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type comp:SongItemRow}}, Path=ShowPlays}"
                    Text="{Binding Plays, StringFormat='{0} plays'}"
                    TextColor="Gray" />

                <Label
                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type comp:SongItemRow}}, Path=ShowUsername}"
                    Text="{Binding User.Name}"
                    TextColor="Gray" />
            </VerticalStackLayout>

        </Grid>

        <VerticalStackLayout
            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type comp:SongItemRow}}, Path=IsCard}"
            Spacing="6"
            WidthRequest="140">

            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPlaySongClicked" />
            </VerticalStackLayout.GestureRecognizers>

            <Border
                HeightRequest="140"
                StrokeShape="RoundRectangle 15"
                WidthRequest="140">

                <Image Aspect="AspectFill" Source="{Binding FullCoverUrl}" />
            </Border>

            <Label
                FontAttributes="Bold"
                FontSize="14"
                LineBreakMode="TailTruncation"
                Text="{Binding Title}"
                TextColor="White" />

            <Label
                FontSize="12"
                LineBreakMode="TailTruncation"
                Text="{Binding User.Name}"
                TextColor="Gray" />

        </VerticalStackLayout>

    </Grid>
</ContentView>