<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AudioHeaven.Components.PlaylistItemRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid Margin="10">
        <HorizontalStackLayout Spacing="6">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHeaderClicked" />
            </HorizontalStackLayout.GestureRecognizers>

            <Border
                HeightRequest="140"
                StrokeShape="RoundRectangle 10"
                WidthRequest="140">
                <Image Aspect="AspectFill" Source="{Binding FullCoverUrl}" />
            </Border>

            <Grid HeightRequest="140" WidthRequest="180">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <VerticalStackLayout Grid.Row="0" VerticalOptions="Start">
                    <Label
                        Margin="0,4"
                        FontAttributes="Bold"
                        FontSize="18"
                        LineBreakMode="TailTruncation"
                        Text="{Binding Title}"
                        TextColor="White">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHeaderClicked" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label
                        FontSize="16"
                        LineBreakMode="TailTruncation"
                        Text="{Binding SongsCount}"
                        TextColor="Gray" />

                    <Label
                        FontSize="16"
                        LineBreakMode="TailTruncation"
                        Text="{Binding LengthFormatted}"
                        TextColor="Gray" />
                </VerticalStackLayout>

                <ImageButton
                    Grid.Row="1"
                    Margin="13"
                    BackgroundColor="Transparent"
                    Clicked="DeletePlaylist"
                    HeightRequest="30"
                    HorizontalOptions="End"
                    Source="bin"
                    VerticalOptions="End"
                    WidthRequest="30" />
            </Grid>
        </HorizontalStackLayout>
    </Grid>
</ContentView>
