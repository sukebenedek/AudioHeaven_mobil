<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AudioHeaven.Components.AlbumItemRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:AudioHeaven.Components"
    xmlns:models="clr-namespace:AudioHeaven.Models"
    x:DataType="models:Album">
    <Grid>

        <!--  Row format (default, date, username)  -->
        <Grid
            Padding="10,7"
            ColumnDefinitions="Auto, *, Auto"
            ColumnSpacing="15"
            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type comp:AlbumItemRow}}, Path=IsCard, Converter={StaticResource InverseBoolConverter}}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHeaderClicked" />
            </Grid.GestureRecognizers>

            <Border
                Grid.Column="0"
                HeightRequest="60"
                StrokeShape="RoundRectangle 10"
                WidthRequest="60">
                <Image Aspect="AspectFill" Source="{Binding FullCoverUrl}" />
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    LineBreakMode="TailTruncation"
                    Text="{Binding Title}"
                    TextColor="White">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHeaderClicked" />
                    </Label.GestureRecognizers>
                </Label>

                <!--  ShowDate: second row shows created date  -->
                <Label
                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type comp:AlbumItemRow}}, Path=ShowDate}"
                    Text="{Binding CreatedAt, StringFormat='{0:MMM d, yyyy}'}"
                    TextColor="Gray" />

                <!--  ShowUsername: second row shows artist name  -->
                <Label
                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type comp:AlbumItemRow}}, Path=ShowUsername}"
                    LineBreakMode="TailTruncation"
                    Text="{Binding User.Name}"
                    TextColor="Gray">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoToUserPageClicked" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

        </Grid>

        <!--  Card format  -->
        <VerticalStackLayout
            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type comp:AlbumItemRow}}, Path=IsCard}"
            Spacing="6"
            WidthRequest="140">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHeaderClicked" />
            </VerticalStackLayout.GestureRecognizers>

            <Border
                HeightRequest="140"
                StrokeShape="RoundRectangle 15"
                WidthRequest="140">
                <Image Aspect="AspectFill" Source="{Binding FullCoverUrl}" />
            </Border>

            <Label
                FontAttributes="Bold"
                FontSize="14"
                LineBreakMode="TailTruncation"
                Text="{Binding Title}"
                TextColor="White">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeaderClicked" />
                </Label.GestureRecognizers>
            </Label>

            <Label
                FontSize="12"
                LineBreakMode="TailTruncation"
                Text="{Binding User.Name}"
                TextColor="Gray">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoToUserPageClicked" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

    </Grid>
</ContentView>