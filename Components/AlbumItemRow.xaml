<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AudioHeaven.Components.AlbumItemRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:AudioHeaven.Models"
    x:DataType="models:Album">

    <Grid
        Margin="0"
        Padding="10,7"
        ColumnDefinitions="Auto, *, Auto"
        ColumnSpacing="15">

        <Border
            Grid.Column="0"
            HeightRequest="60"
            StrokeShape="RoundRectangle 10"
            WidthRequest="60">
            <Image Aspect="AspectFill" Source="{Binding FullCoverUrl}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeaderClicked" />
                </Image.GestureRecognizers>
            </Image>
        </Border>

        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
            <Label
                FontAttributes="Bold"
                FontSize="18"
                LineBreakMode="TailTruncation"
                Text="{Binding Title}"
                TextColor="White">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeaderClicked" />
                </Label.GestureRecognizers>
            </Label>

            <Label
                FontSize="14"
                Text="{Binding User.Name}"
                TextColor="Gray">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoToUserPageClicked" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

        <!--<ImageButton Grid.Column="2"
                     Source="meatballs.png"
                     BackgroundColor="Transparent"
                     VerticalOptions="Center"
                     HeightRequest="30"
                     WidthRequest="30"/>-->
    </Grid>
</ContentView>