<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AudioHeaven.Components.UserItemCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:AudioHeaven.Models"
    x:DataType="models:User">

    <VerticalStackLayout
        HorizontalOptions="Center"
        Spacing="8"
        WidthRequest="100">

        <Border
            HeightRequest="90"
            HorizontalOptions="Center"
            StrokeThickness="0"
            WidthRequest="90">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="45" />
            </Border.StrokeShape>

            <Image
                Aspect="AspectFill"
                BackgroundColor="{x:DynamicResource DarkGray}"
                Source="{Binding FullProfilePicUrl}" />
        </Border>

        <Label
            FontAttributes="Bold"
            FontSize="16"
            HorizontalTextAlignment="Center"
            LineBreakMode="TailTruncation"
            MaxLines="1"
            Text="{Binding Name}"
            TextColor="White" />

    </VerticalStackLayout>
</ContentView>